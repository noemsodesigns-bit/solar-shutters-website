# Serve the Markdown twin to AI agents that ask for it.
#
# An agent sending "Accept: text/markdown" gets the .md instead of the
# .html -- roughly 85% fewer tokens for the same content (8.5 KB vs 57 KB
# on the homepage). Browsers never send that header, so people always get
# the normal page. Verified live 2026-08-22.
#
# Note: one.com applies .htaccess changes about 30 seconds after upload.
# Test with a wait, not immediately after deploying.
#
# The .md files are generated by tools-build-markdown.py -- re-run it
# after any content change or the twins go stale.
<IfModule mod_mime.c>
  AddType text/markdown .md
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_ACCEPT} markdown [NC]
  RewriteRule ^(.+)\.html$ $1.md [L]
</IfModule>
