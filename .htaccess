# Serve the Markdown twin to AI agents that ask for it.
#
# An agent sending "Accept: text/markdown" gets the .md instead of the
# .html -- roughly 85% fewer tokens for the same content. Browsers never
# send that header, so people are unaffected.
#
# Note: one.com applies .htaccess changes about 30 seconds after upload.
# Test with a wait, not immediately after deploy.
<IfModule mod_mime.c>
  AddType text/markdown .md
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # probe: confirms .htaccess rewrites are being applied
  RewriteRule ^htaccess-probe$ nl/index.md [L]

  RewriteCond %{HTTP_ACCEPT} markdown [NC]
  RewriteRule ^(.+)\.html$ $1.md [L]
</IfModule>
